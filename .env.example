# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/box_mailing?schema=public"

# Application
NODE_ENV=development
PORT=3000

# File storage (stub — replace with real provider config in production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/tmp/box_mailing_files
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_AZURE_CONTAINER=

# Auth (stub — wire in real provider in Phase 2)
JWT_SECRET=change_me_before_production
JWT_EXPIRES_IN=8h
